# ==============================================================================
# Smart Income & Expense Management - Environment Variables Configuration
# Copy this file to '.env' for local development or add these keys in Vercel.
# ==============================================================================

# 1. MongoDB Database Connection String
# ------------------------------------------------------------------------------
# For Local Development:
# MONGO_URI=mongodb://127.0.0.1:27017/income_expense
#
# For Production / Vercel Deployment (MongoDB Atlas):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/income_expense?retryWrites=true&w=majority

# 2. JWT Authentication Secret
# ------------------------------------------------------------------------------
# A strong, unique secret key used to sign and verify user JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 3. Email Service Configuration (Optional)
# ------------------------------------------------------------------------------
# Used by Nodemailer for sending temporary password reset emails
# Note: For Gmail, use an App Password (not your personal account password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
